# Public Clerk configuration
VITE_CLERK_PUBLISHABLE_KEY=

# Public Firebase web configuration (database transport only; Clerk owns sign-in)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Local browser SDKs only. Production builds ignore/reject this opt-in.
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080

# Server-only Firebase Admin credentials. Prefer workload identity in production.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative for local tooling only; never expose this through a VITE_ variable.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local Admin SDK only; production must keep this false and omit emulator hosts.
FIREBASE_USE_EMULATORS=false
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
MIGRATION_CONFIRM_PROJECT_ID=
# Required for migrate:apply; use the identifier of a verified, restorable backup.
MIGRATION_BACKUP_REFERENCE=

# High-risk routing policy. Resolution order: this path, then
# server/safety-policy.local.json, then the shipped illustrative
# server/safety-policy.json. The evaluated trigger set is never committed.
# Evaluated high-risk routing policy, inline JSON. THIS IS HOW PRODUCTION IS SERVED:
# a deployment has no filesystem for a gitignored file. A production runtime
# refuses to start unless the policy it loads is marked "evaluated": true.
SAFETY_POLICY_JSON=
# File-path alternative, for local overrides only.
SAFETY_POLICY_PATH=
# Evaluated safety corpus, for reproducing the recorded evaluation. Falls back to
# tests/safety/corpus.local.json, then the shipped illustrative tests/safety/corpus.json.
SAFETY_CORPUS_PATH=

# Server-only model configuration
RELEASE_VERSION=development
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_SYSTEM_PROMPT=
OPENAI_PROMPT_VERSION=ef-support-v1
OPENAI_HISTORY_LIMIT=5
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_OUTPUT_TOKENS=800

# Server protections
ALLOWED_ORIGINS=http://localhost:5173
GUEST_TOKEN_HMAC_SECRET=
SAFETY_IDENTIFIER_HMAC_SECRET=
RATE_LIMIT_HMAC_SECRET=
# Server-only PEM public key from Clerk Dashboard > API keys > Show JWT public key.
# Keep literal newlines locally or use escaped \n sequences in deployment configuration.
CLERK_JWT_KEY=
GUEST_TOKEN_TTL_SECONDS=1800
REQUEST_BODY_LIMIT_BYTES=65536
REGISTERED_RATE_LIMIT=20
GUEST_RATE_LIMIT=5
IP_RATE_LIMIT=30
RATE_LIMIT_WINDOW_MS=60000
DELETE_BATCH_SIZE=200
IDEMPOTENCY_TTL_SECONDS=86400
PROVIDER_CONCURRENCY_LIMIT=20
EMOTION_CONTEXT_MAX_AGE_MS=300000
EMOTION_CONTEXT_FUTURE_SKEW_MS=30000
SUPPORTED_CAMERA_NOTICE_VERSIONS=camera-notice-v1

# Optional client diagnostics. Never send message or camera content.
VITE_RELEASE_VERSION=development
