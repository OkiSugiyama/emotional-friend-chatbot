{
  "name": "emotional-friend-chatbot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc6 -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc6 -b --pretty false",
    "test": "vitest run",
    "test:rules": "npx --yes firebase-tools@15.26.0 emulators:exec --only firestore --project demo-emotional-friend-rules \"vitest run tests/security/firestore-rules.emulator.test.ts\"",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate:plan": "node scripts/migrate-firestore.mjs",
    "migrate:apply": "node scripts/migrate-firestore.mjs --apply",
    "check": "npm run typecheck && npm run test && npm run test:rules && npm run build"
  },
  "dependencies": {
    "@clerk/react": "^6.13.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@vladmandic/face-api": "^1.7.15",
    "firebase": "^12.17.1",
    "firebase-admin": "13.10.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.30.0",
    "openai": "^7.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jest-axe": "^11.0.0",
    "jsdom": "^29.1.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
